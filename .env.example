# =============================================================================
# Agent 365 MCP Bridge — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your Azure credentials.
# See README.md for the full setup guide.
# =============================================================================

# --- Azure Entra ID Authentication ---
# Get these from your Azure AD App Registration (Overview page)
AZURE_TENANT_ID=your-directory-tenant-id
AZURE_CLIENT_ID=your-application-client-id

# Client secret — NOT required for the default Device Code flow.
# Only needed for server deployment (OBO) or Application permissions (client_credentials).
# AZURE_CLIENT_SECRET=your-client-secret-value

# (Optional) Pre-acquired bearer token — skips Azure auth entirely
# BEARER_TOKEN=your-token-here

# (Optional) Auth mode:
#   device_code (default) — interactive sign-in, Delegated permissions, NO secret needed
#   client_credentials    — headless, Application permissions, requires AZURE_CLIENT_SECRET
#   obo                   — HTTP server mode (Copilot Studio), requires AZURE_CLIENT_SECRET
# AUTH_MODE=device_code

# --- Agent 365 Platform ---
MCP_PLATFORM_ENDPOINT=https://agent365.svc.cloud.microsoft
MCP_PLATFORM_AUTHENTICATION_SCOPE=ea9ffc3e-8a23-4a7d-836d-234d7c7565c1/.default

# (Optional) Agentic App ID — required for gateway-based server discovery
# AGENTIC_APP_ID=your-agent-app-id

# --- Runtime ---
NODE_ENV=development

# =============================================================================
# Login / Admin console app (/app) — independent of the MCP bridge auth above
# =============================================================================

# --- Azure Table Storage (also used by the existing session token cache) ---
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_STORAGE_KEY=your-storage-account-key

# Secret used to sign app session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Public URL of this server, used to build password-reset links in emails
PUBLIC_BASE_URL=http://localhost:3000

# One-time bootstrap: creates the first admin account if no app users exist yet.
# Safe to remove from the environment after first successful login.
INITIAL_ADMIN_EMAIL=admin@abk.gr
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Password-reset emails are sent via app-only Graph (Mail.Send Application
# permission + tenant admin consent required on the Azure AD app registration —
# see README). The sender address defaults to snikolaou@abk.gr and can be
# changed by an admin from the /app/admin/settings page.
